"""
agent2_batch_scorer.py — Agent 2: the Batch Scorer
===================================================
Reads loan_applications.csv, scores every applicant with the same rule
engine Agent 1 uses, and prints the officer's morning worklist.
Governance built into the output: NEEDS HUMAN REVIEW is always listed
first — unclear cases are where mistakes cost the most.

Run:  python agent2_batch_scorer.py
"""
import csv, sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from loan_rules import Applicant, check

_HERE = os.path.dirname(os.path.abspath(__file__))
# The CSV ships beside this script in the kit; older layouts kept it one level up.
CSV = os.path.join(_HERE, "loan_applications.csv")
if not os.path.exists(CSV):
    CSV = os.path.join(_HERE, "..", "loan_applications.csv")

def load_applicants(path=CSV):
    out = []
    with open(path, newline="", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            notes = row.get("officer_notes", "")
            out.append(Applicant(
                applicant_id=row["applicant_id"],
                name=row["name"],
                age=int(row["age"]),
                net_monthly_income_inr=float(row["net_monthly_income_inr"]),
                existing_emi_inr=float(row["existing_emi_inr"]),
                loan_amount_requested_inr=float(row["loan_amount_requested_inr"]),
                tenure_months=int(row["tenure_months"]),
                credit_score=int(row["credit_score"]),
                documents_submitted=[d.strip() for d in row["documents_submitted"].split(";")],
                # Teaching simplification: in the CSV, a contradiction is flagged in the
                # officer notes with the word "verify". In the LLM notebook, the model
                # detects contradictions from the application text itself.
                consistency_flag=("verify" in notes.lower()),
                consistency_note=notes if "verify" in notes.lower() else "",
            ))
    return out

def worklist(applicants):
    buckets = {"NEEDS HUMAN REVIEW": [], "READY FOR REVIEW": [],
               "COLLECT ITEMS FIRST": [], "NOT ELIGIBLE AT THIS TIME": []}
    for a in applicants:
        r = check(a)
        rec = r["recommendation"]
        line = f"{a.name} ({a.applicant_id}) — {rec}"
        if rec.startswith("NEEDS HUMAN REVIEW"):
            buckets["NEEDS HUMAN REVIEW"].append(line)
        elif rec.startswith("Ready"):
            buckets["READY FOR REVIEW"].append(line)
        elif rec.startswith("Collect"):
            buckets["COLLECT ITEMS FIRST"].append(line)
        else:
            buckets["NOT ELIGIBLE AT THIS TIME"].append(line)
    return buckets

if __name__ == "__main__":
    apps = load_applicants()
    b = worklist(apps)
    print(f"MORNING WORKLIST — {len(apps)} applications\n" + "=" * 46)
    # Governance: unclear cases first, always.
    for bucket in ("NEEDS HUMAN REVIEW", "READY FOR REVIEW",
                   "COLLECT ITEMS FIRST", "NOT ELIGIBLE AT THIS TIME"):
        print(f"\n{bucket} ({len(b[bucket])})")
        for line in b[bucket] or ["  — none —"]:
            print("  " + line if line.startswith(" ") is False else line)
    print("\nEvery line is a recommendation. The loan officer decides.")
